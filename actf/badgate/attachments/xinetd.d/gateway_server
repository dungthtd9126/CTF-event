service ctf
{
    disable = no
    socket_type = stream
    protocol    = tcp
    wait        = no
    user        = root
    type        = UNLISTED
    port        = 9999
    bind        = 0.0.0.0
    server      = /usr/sbin/chroot
    server_args = --userspec=1001:1001 /home/ctf ./badgate
    per_source	= 4
    cps         = 50 10
    instances   = 512
    rlimit_cpu  = 30
}
